# Static export artifacts (regenerate with: make export)
.export/

# Emacs build outputs
*.elc

# Harness session state, not project content
.agent-org/

# Site bundler outputs (once the Svelte app is wired in)
node_modules/
dist/

# Playwright MCP browser snapshots (session artifacts, not project content)
.playwright-mcp/

# Ad-hoc export log (make export 2>&1 | tee export.log)
export.log

# Verification screenshots (regenerate with make verify)
shots/
verify-*.png

# Qoder session state
.qoder/

# In-workspace sibling clones (R-2-69 task segments clone the UI repos
# here to work on them; the landing gate clones the same repos OUTSIDE
# the workspace. Either way: sibling source is never docneural content)
/docneural-ui/
/synapt/
/org-roam-lite-ui/

# GitHub Pages corpus derived from repo docs (scripts/gh-corpus-prep.py)
/.gh-corpus/
.manuals-tmp/
