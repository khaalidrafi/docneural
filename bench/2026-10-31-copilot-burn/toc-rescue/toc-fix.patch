+export type TocItem = {
+  id: string
+  title: string
+  degree?: number
+  order?: number
+  depth?: number
+  children: TocItem[]
+  open?: boolean
+}
+
+export const defaultOpen = (depth: number): boolean => depth < 2
+
+export function setAllOpen<T extends { children: T[]; open?: boolean }>(
+  nodes: T[],
+  open: boolean,
+): T[] {
+  return nodes.map(node => ({
+    ...node,
+    open,
+    children: setAllOpen(node.children, open),
+  }))
+}
+
+export function filterToc<T extends { title: string; children: T[] }>(
+  nodes: T[],
+  query: string,
+): T[] {
+  const needle = query.trim().toLocaleLowerCase()
+  if (!needle) return nodes
+  return nodes.flatMap(node => {
+    const children = filterToc(node.children, query)
+    return node.title.toLocaleLowerCase().includes(needle) || children.length
+      ? [{ ...node, children }]
+      : []
+  })
+}
+
+const KNOWN = /^(introduction|getting started|basics|commands|customization|reference|appendices|indexes?)\b/i
+
+function prefix(title: string): string {
+  const clean = title.replace(/^(?:chapter|part|section)?\s*[\d.ivx.)-]*\s*/i, '').trim()
+  const known = clean.match(KNOWN)?.[1]
+  if (known) return known.replace(/\s+/g, ' ')
+  const words = clean.split(/\s+/).filter(Boolean)
+  return words.slice(0, 2).join(' ') || 'Other'
+}
+
+export function clusterOrRankFallback(
+  nodes: Array<Omit<TocItem, 'children'> & { order?: number }>,
+): TocItem[] {
+  const groups = new Map<string, TocItem>()
+  for (const [index, node] of nodes.entries()) {
+    const key = prefix(node.title)
+    const group = groups.get(key) ?? {
+      id: `group:${key}`, title: key, children: [], order: index,
+    }
+    group.children.push({ ...node, children: [], order: node.order ?? index })
+    groups.set(key, group)
+  }
+  const largest = Math.max(...[...groups.values()].map(group => group.children.length), 0)
+  if (groups.size >= 4 && largest <= nodes.length * 0.6) {
+    return [...groups.values()].sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
+  }
+  return nodes
+    .map((node, order) => ({ ...node, children: [], order: node.order ?? order }))
+    .sort((a, b) => (b.degree ?? 0) - (a.degree ?? 0) || (a.order ?? 0) - (b.order ?? 0))
+}
+
+export function hasAlphabetFallback(nodes: Array<{ title: string; children?: unknown[] }>): boolean {
+  return nodes.length > 24 && nodes.every(node => /^[A-Z]$/.test(node.title))
+}
