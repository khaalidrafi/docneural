+<script lang="ts">
+  import { onDestroy } from 'svelte'
+  import { defaultOpen, filterToc, setAllOpen } from '../core/toc'
+
+  let query = $state('')
+  let settledQuery = $state('')
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let allOpen = $state(false)
+  let open = $state(new Set<string>())
+
+  $effect(() => {
+    clearTimeout(timer)
+    timer = setTimeout(() => { settledQuery = query }, 250)
+  })
+  onDestroy(() => clearTimeout(timer))
+
+  const visible = $derived(filterToc(toc, settledQuery))
+  const isOpen = (id: string, depth: number) => allOpen || open.has(id) || defaultOpen(depth)
+  function toggle(id: string) {
+    const next = new Set(open)
+    next.has(id) ? next.delete(id) : next.add(id)
+    open = next
+  }
+  function setEveryBranch(value: boolean) {
+    allOpen = value
+    open = new Set(value ? toc.map(node => node.id) : [])
+  }
+</script>
+
+<div class="toc-tools">
+  <input class="toc-filter" bind:value={query} placeholder="Filter chapters" aria-label="Filter chapters" />
+  <button class="toc-action" type="button" onclick={() => setEveryBranch(true)}>Expand all</button>
+  <button class="toc-action" type="button" onclick={() => setEveryBranch(false)}>Collapse all</button>
+</div>
