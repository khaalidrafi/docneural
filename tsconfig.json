{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "synapt": ["../synapt/src/lib/SynaptApp.svelte"],
      "synapt/store": ["../synapt/src/lib/core/store.svelte.ts"],
      "synapt/core": ["../synapt/src/lib/core/graph.ts"],
      "synapt/styles/synapt.css": ["../synapt/styles/synapt.css"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
