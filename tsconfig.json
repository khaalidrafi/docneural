{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "docneural-ui": ["../synapt/src/lib/DocneuralApp.svelte"],
      "docneural-ui/store": ["../synapt/src/lib/core/store.svelte.ts"],
      "docneural-ui/core": ["../synapt/src/lib/core/graph.ts"],
      "docneural-ui/styles/docneural-ui.css": ["../synapt/styles/docneural-ui.css"],
      "orui/*": ["../org-roam-lite-ui/src/lib/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.ts"
  ]
}
