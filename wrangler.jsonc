// dn-site — the docneural site on CF Workers (static assets, no AI bindings).
// Canonical host: https://docneural.khalidrafi.tech (custom domain, zone on
// this CF account). Fallback mirror: https://dn-site.khalidrafi.workers.dev
// Build first: `make build` in THIS repo (apex base) — it assembles the full
// corpus (graph.json + docs/ + ctx/ + bridges.json + sitemap) around the
// sibling docneural-ui theme. Deploy:
//   CLOUDFLARE_API_TOKEN=… CLOUDFLARE_ACCOUNT_ID=… npx wrangler deploy
{
  "name": "dn-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "docneural.khalidrafi.tech", "custom_domain": true }
  ]
}
